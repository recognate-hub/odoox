<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo_claude_mcp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block')]" position="inside">
                <h2 groups="base.group_system">Claude CRM Integration (MCP)</h2>
                <div class="row mt16 o_settings_container" groups="base.group_system">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="claude_api_key"/>
                            <div class="text-muted">
                                Enter your Anthropic API Key (e.g. sk-ant-...)
                            </div>
                            <field name="claude_api_key" password="True"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="claude_model_name"/>
                            <div class="text-muted">
                                Select the Claude model to use
                            </div>
                            <field name="claude_model_name"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="claude_temperature"/>
                            <div class="text-muted">
                                Set the generation temperature (0.0 for deterministic)
                            </div>
                            <field name="claude_temperature"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
