# Odoo Connection Configuration
# The URL of the Odoo instance (e.g., https://my-company.odoo.com)
ODOO_URL=https://odoo.example.com
# The name of the Odoo database
ODOO_DB=my_database
# The username (email) used to connect to Odoo
ODOO_USERNAME=admin@example.com
# The password or API key for the user
ODOO_PASSWORD=your_api_key_or_password

# Anthropic / Claude Configuration
# Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
# The Claude model to use (default: claude-3-5-sonnet-20240620)
CLAUDE_MODEL=claude-3-5-sonnet-20240620
# Temperature for Claude completions (0.0 to 1.0)
CLAUDE_TEMPERATURE=0.0
# Timeout for Anthropic API calls in seconds
CLAUDE_TIMEOUT=30

# MCP / Server Configuration
# The host address to bind the server to
SERVER_HOST=0.0.0.0
# The port to bind the server to
SERVER_PORT=8000
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Supabase (Multi-Tenant SaaS Configuration)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR...

# Client/Tenant Identification (for prompts, etc.)
COMPANY_NAME="Acme Corp"
COMPANY_EMAIL="contact@acme.com"
COMPANY_PHONE="+1-555-0123"
